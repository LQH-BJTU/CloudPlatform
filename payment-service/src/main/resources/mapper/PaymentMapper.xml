<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sustar.paymentservice.mapper.PaymentMapper">

    <select id="selectByPaymentNo" resultType="com.sustar.paymentservice.po.PaymentPO">
        SELECT * FROM payment_record WHERE payment_no = #{paymentNo}
    </select>

    <select id="selectByOrderNo" resultType="com.sustar.paymentservice.po.PaymentPO">
        SELECT * FROM payment_record WHERE order_no = #{orderNo} ORDER BY create_time DESC
    </select>

    <select id="selectByThirdPartyNo" resultType="com.sustar.paymentservice.po.PaymentPO">
        SELECT * FROM payment_record WHERE third_party_no = #{thirdPartyNo}
    </select>

</mapper>
